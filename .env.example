# Add these in Vercel Dashboard -> Project -> Settings -> Environment Variables

STRIPE_SECRET_KEY=sk_live_PASTE_HERE
STRIPE_WEBHOOK_SECRET=whsec_PASTE_HERE
# Stripe Product IDs are the primary pricing source. The app reads each
# product's current default Price from Stripe, so changing the default Price in
# Stripe updates checkout and visible site prices after cache expiry.
STRIPE_READY_REPORT_PRODUCT_ID=prod_UtBtnbEY6jZjI0
STRIPE_FRESH_REPORT_PRODUCT_ID=prod_UtBsf3RcUsub19
# Optional fallback Price IDs if a product lookup is unavailable.
STRIPE_READY_REPORT_PRICE_ID=price_READY_REPORT_20_EUR
STRIPE_FRESH_REPORT_PRICE_ID=price_FRESH_REPORT_50_EUR

# Revision tiers (docs/forecast-gate-plan.md): ready/fresh/free "+ Revisions"
# and the extra revision round. Unlike the product pairs above, no ID needs to
# be pasted here: each product is found by its `kind` metadata tag (set by
# scripts/stripe-setup-revisions.mjs on create). Only set
# STRIPE_{READY,FRESH,FREE}_REPORT_REVISIONS_{PRODUCT,PRICE}_ID or
# STRIPE_EXTRA_REVISION_{PRODUCT,PRICE}_ID to override which product/price is
# used. The three "+ Revisions" tiers have no fallback price — checkout fails
# loudly if unconfigured rather than selling at a guessed amount. Master flag
# ships false.
FORECAST_REVISIONS_ENABLED=false
# Revision requests a "+ Revisions" purchase includes when its Stripe product
# has no metadata.revisions (the setup script writes 2 / 2 / 3). Ready+ and
# fresh+ are a €5 add-on with two; revisions on a free report are the whole
# €10 purchase with three; a bought fork (members) comes with three.
REPORT_REVISIONS_INCLUDED=2
FREE_REPORT_REVISIONS_INCLUDED=3
FORK_REVISIONS_INCLUDED=3
# Extra revision round price, used only until the extra-revision product exists.
EXTRA_REVISION_EUR=5
# Email delivery uses AWS SES (SESv2). Credentials come from the standard AWS
# env vars below
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FROM_EMAIL=reports@valuatum.com
SITE_URL=https://YOUR_VERCEL_DOMAIN_HERE
ADMIN_EMAIL=contact26@valuatum.com

# Dynamic report catalog: the AWS API Lambda (infra/), which the Vercel
# functions proxy to. The sync secret is the same value stored in SSM there.
CATALOG_API_URL=https://api.aiequityreports.com
CATALOG_SYNC_SECRET=PASTE_LONG_RANDOM_SECRET_HERE

# Static company page generator (run locally)
WISDOM_API_BASE=https://wisdom.valuatum.com/rest
WISDOM_API_TOKEN=PASTE_BEARER_TOKEN_HERE
AI_PROVIDER=codex
# Low-cost default used by the generator. Override when another Codex model is preferred.
AI_MODEL=gpt-5.4-mini
AI_REASONING_EFFORT=low
# Optional when the executable is not available as "codex" on PATH.
# CODEX_BIN=/path/to/codex

# Report-content extraction (scripts/report-pages/sync.mjs). In production the key lives as a
# GitHub Actions secret; set it here only to run the sync locally. The model is pinned in
# scripts/report-pages/extract.mjs — see docs/report-content-generation.md for the measurements.
OPENROUTER_API_KEY=sk-or-v1-PASTE_HERE
