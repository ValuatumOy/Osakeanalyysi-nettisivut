{
  "name": "valuatum-ai-reports",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:companies": "node scripts/generate-company-pages.mjs",
    "report:sync": "node scripts/report-pages/sync.mjs",
    "report:check": "node scripts/report-pages/check.mjs",
    "report:thumbs": "python3 scripts/report-thumbnails.py",
    "report:thumbs:check": "python3 scripts/report-thumbnails.py --check",
    "test:api": "node --test test/api/*.test.mjs",
    "test:company-pages": "node --test test/company-pages/*.test.mjs",
    "test:catalog": "node --test test/catalog/*.test.mjs",
    "test:members": "node --test test/members/*.test.mjs",
    "test:orders": "node --test test/orders/*.test.mjs",
    "test:reaper": "node --test test/reaper/*.test.mjs",
    "test:reconciler": "node --test test/reconciler/*.test.mjs",
    "test:stripe-pricing": "node --test test/stripe-pricing/*.test.mjs",
    "validate:jsonld": "node scripts/validate-jsonld.mjs",
    "seo:llms": "node scripts/build-llms-txt.mjs",
    "seo:companies": "node scripts/build-company-index.mjs",
    "seo:pricing": "node scripts/build-pricing-md.mjs",
    "seo:freshness": "node scripts/build-page-freshness.mjs",
    "seo:og": "node scripts/build-og-images.mjs",
    "seo:titles": "node scripts/retitle-report-pages.mjs",
    "seo:build": "npm run seo:titles && npm run seo:companies && npm run seo:llms && npm run seo:pricing && npm run seo:freshness && npm run seo:analyst-section",
    "seo:check": "node scripts/retitle-report-pages.mjs --check && node scripts/build-company-index.mjs --check && node scripts/build-llms-txt.mjs --check && node scripts/build-pricing-md.mjs --check && node scripts/build-page-freshness.mjs --check && node scripts/build-og-images.mjs --check && node scripts/retire-report-store.mjs --check && node scripts/add-analyst-section.mjs --check && node scripts/validate-jsonld.mjs",
    "seo:analyst-section": "node scripts/add-analyst-section.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "aws4fetch": "^1.0.20",
    "stripe": "^17.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
