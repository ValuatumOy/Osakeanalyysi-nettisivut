# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_PASTE_HERE

# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# (Add this AFTER deploying — see setup instructions)
STRIPE_WEBHOOK_SECRET=whsec_PASTE_HERE

# Stripe Price IDs for product-scoped coupons and promotion codes.
# Use the 20 EUR one-time Price ID for ready reports and the 50 EUR one-time Price ID for fresh reports.
STRIPE_READY_REPORT_PRICE_ID=price_READY_REPORT_20_EUR
STRIPE_FRESH_REPORT_PRICE_ID=price_FRESH_REPORT_50_EUR

# ── Email (AWS SES) ────────────────────────────────────────────────────────────
# Delivery uses SESv2. Credentials come from the standard AWS credential chain:
# set the keys below
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

FROM_EMAIL=reports@valuatum.com

# ── App ────────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (for success/cancel redirects)
SITE_URL=https://YOUR_VERCEL_URL_HERE

# Where to send fresh report order notifications
ADMIN_EMAIL=contact26@valuatum.com

# Port for the Express server
PORT=3001

# ── PDF report engine (Task A) ──────────────────────────────────────────────────
# Lambda Function URL of the deployed engine (PdfReport-Api stack output).
PDF_ENGINE_URL=https://jdnrhdk37rmqzayy2km4jyrlgq0uapaw.lambda-url.eu-west-1.on.aws
# pdf-report-backend-invoker access key — used to SigV4-sign engine calls.
# (The files.valuatum.com box is outside the engine's AWS account, so an
#  instance role is not usable; sign with these static keys.)
AWS_INVOKER_ACCESS_KEY_ID=AKIA_PASTE_HERE
AWS_INVOKER_SECRET_ACCESS_KEY=PASTE_HERE
# Optional overrides (defaults shown):
# PDF_ENGINE_REGION=eu-west-1
# PDF_ENGINE_ASP_QUERY_KEY=Wisdom
# PDF_ENGINE_TEMPLATE=osakeanalyysi
# PDF_ENGINE_USERNAME=osakeanalyysi-site

# ── FMP fresh import (Task E — feature-flagged, default off) ─────────────────────
# Leave disabled until the endpoint is on the SAME env the engine reads (prod
# wisdom) and Controller.DataImport is granted to the service user.
FRESH_IMPORT_ENABLED=false
# FMP_IMPORT_URL=https://trunkdev.valuatum.com/rest/dataimport
# FMP_IMPORT_TOKEN=PASTE_BEARER_HERE
# FMP_IMPORT_ASP_ID=131

# ── Wisdom company search (Task B) ───────────────────────────────────────────────
# Powers the fresh-order picker. The bearer token is a provisioned APITOKEN for a
# service user with aspId 131 + Controller.Company permission. Stays server-side.
WISDOM_API_TOKEN=PASTE_BEARER_HERE
# Optional overrides (defaults shown):
# WISDOM_REST_BASE=https://wisdom.valuatum.com
# WISDOM_TIMEOUT_MS=6000
# WISDOM_MAX_RESULTS=10
# WISDOM_CACHE_TTL_MS=60000

# ── Reconciler tuning (Task D) ───────────────────────────────────────────────────
# RECONCILER_INTERVAL_MS=45000
# RECONCILER_MAX_POLLS=40
# RECONCILER_MAX_ATTEMPTS=6
# Email the admin on every successful delivery (dev/testing visibility). Set
# false in production — generation FAILURES always email the admin regardless.
ADMIN_NOTIFY_ON_SUCCESS=true
