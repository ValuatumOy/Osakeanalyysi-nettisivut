# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_PASTE_HERE

# Get from: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
# (Add this AFTER deploying — see setup instructions)
STRIPE_WEBHOOK_SECRET=whsec_PASTE_HERE

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY=re_PASTE_HERE

# The "from" address — must be a verified domain in your Resend account
# Verify valuatum.com at: resend.com → Domains → Add Domain → add 3 DNS records
FROM_EMAIL=reports@valuatum.com

# ── App ────────────────────────────────────────────────────────────────────────
# Your Vercel frontend URL (for success/cancel redirects)
SITE_URL=https://YOUR_VERCEL_URL_HERE

# Where to send fresh report order notifications
ADMIN_EMAIL=contact26@valuatum.com

# Port for the Express server
PORT=3001
